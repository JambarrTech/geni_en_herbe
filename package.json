{
  "name": "aeerks-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AEERKS — Génie en Herbe : monorepo des trois frontends (live, jury, admin)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "serve": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "eslint apps/live/src apps/jury/src apps/admin/src shared backend/src",
    "test": "node --import tsx --test backend/test/*.test.mjs",
    "verify:css": "node scripts/verify-build-output.mjs",
    "verify:coverage": "node scripts/audit-css-coverage.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.20.0"
  }
}
