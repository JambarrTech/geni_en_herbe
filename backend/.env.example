# ---------------------------------------------------------------------------
# AEERKS — variables d'environnement du BACKEND
# Copiez ce fichier en `backend/.env` (déjà présent dans .gitignore).
# ---------------------------------------------------------------------------

# --- Serveur HTTP ---
PORT=3000

# Derrière un reverse proxy (nginx, Cloudflare, Fly...) : mettez `true` pour
# que req.ip lise X-Forwarded-For. Sans cela, le rate-limit de connexion se
# bucketise sur l'IP du proxy (un seul compteur pour tout le LAN).
TRUST_PROXY=false

# --- Base de données (PostgreSQL / Neon serverless) ---
# Option recommandée (Neon) : chaîne de connexion complète, SSL requis.
# DATABASE_URL=postgres://user:password@ep-xxxx-yyy.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Alternative : PostgreSQL classique, variables séparées.
SQL_HOST=localhost
SQL_USER=postgres
SQL_PASSWORD=
SQL_DB_NAME=aeerks

# Compte admin utilisé uniquement par drizzle-kit generate / migrate.
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=

# --- Firebase Admin (serveur) ---
# Facultatif : le projet est lu depuis firebase-applet-config.json à la racine.
# Pour une authentification Firebase complète, positionnez
# FIREBASE_SERVICE_ACCOUNT_PATH ou GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_PROJECT_ID=

# --- Mode production ---
# En production, le backend sert les builds Vite depuis apps/*/dist.
# NODE_ENV=production
