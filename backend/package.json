{
  "name": "aeerks-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend AEERKS - Genie en Herbe (API REST, diffusion WS, worker chrono, statique)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:api": "tsx src/index.ts",
    "start:ws": "tsx src/server/ws.ts",
    "start:worker": "tsx src/server/worker.ts",
    "start:static": "tsx src/server/static.ts",
    "dev:api": "tsx watch src/index.ts",
    "dev:ws": "tsx watch src/server/ws.ts",
    "dev:worker": "tsx watch src/server/worker.ts",
    "dev:static": "tsx watch src/server/static.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:admin": "tsx src/db/seed-admin.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "drizzle-orm": "https://registry.npmjs.org/drizzle-orm/-/drizzle-orm-0.45.2.tgz",
    "express": "^4.21.2",
    "http-proxy": "^1.18.1",
    "pg": "^8.23.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
