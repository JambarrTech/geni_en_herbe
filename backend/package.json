{
  "name": "aeerks-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend AEERKS - Génie en Herbe (API REST + WebSocket + PostgreSQL/Drizzle)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "drizzle-orm": "https://registry.npmjs.org/drizzle-orm/-/drizzle-orm-0.45.2.tgz",
    "express": "^4.21.2",
    "firebase-admin": "^14.4.0",
    "pg": "^8.23.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
