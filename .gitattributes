# Normalisation des fins de ligne : LF en dépôt, CRLF au checkout Windows.
* text=auto eol=lf

# Fichiers texte
*.ts text
*.tsx text
*.mjs text
*.js text
*.json text
*.css text
*.html text
*.md text
*.sql text
*.yml text
*.yaml text

# Fichiers binaires
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
